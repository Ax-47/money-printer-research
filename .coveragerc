# INI Syntax

[run]
# Requires a .test_reports directory, which will be automatically created by tests/conftest.py.
data_file = .test_reports/coverage/.coverage
source =
    src
branch = True
# parallel = True
# Optional: Exclude files from coverage reporting
omit =
    .tox/*
    .venv/*
    __pycache__/*
    .git/*

# Overall report settings.
[report]
fail_under = 100
# Console-script glue: main() and exec_*() only read the real files under data/, call
# functions the tests cover, and print. `uv run pipeline` runs them; tests do not.
exclude_also =
    def main\(
    def exec_\w+\(
# List the uncovered lines; the PR coverage comment reads them as its Missing column.
show_missing = True

# HTML report settings.
[html]
directory = .test_reports/coverage/html
